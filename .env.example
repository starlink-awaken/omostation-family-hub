# Family Hub — Environment Variables
# Copy to .env and fill in values (CHANGE_ME) before running

# gbrain (知识图谱数据库)
GBRAIN_DATABASE_URL=postgresql://gbrain:CHANGE_ME@127.0.0.1:5433/brain
GBRAIN_CLI_PATH=src/cli.ts

# API security
FAMILY_HUB_API_TOKEN=CHANGE_ME
FAMILY_HUB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FAMILY_HUB_AUDIT_PATH=.local-audit/api-writes.jsonl

# Frontend (Vite)
VITE_API_URL=http://localhost:3001/api
VITE_FAMILY_HUB_API_TOKEN=CHANGE_ME
