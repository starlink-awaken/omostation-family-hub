NEXT_PUBLIC_APP_NAME=family-dashboard-app
FAMILY_DOCUMENTS_ROOT=/absolute/path/to/read-only/family-documents
FAMILY_DASHBOARD_STATE_ROOT=/absolute/path/to/workspace/runtime/family-hub/dashboard
FAMILY_DASHBOARD_PASSWORD=change_me
FAMILY_DASHBOARD_COOKIE_TTL_DAYS=7
FAMILY_AI_GATEWAY=http://127.0.0.1:4000
FAMILY_AI_REDACT_CONTEXT=true
COCKPIT_INTERNAL_URL=http://127.0.0.1:7410
FAMILY_HITL_COCKPIT_API_KEY=replace_with_scoped_key
FAMILY_CSRF_TOKEN=replace_with_random_token

# Push notifications via Bark (iOS)
# Get your key at https://api.day.app/register
BARK_API_KEY=your_bark_key_here

# Cron authentication token
# Set a random string and use it in cron-job.org URL
FAMILY_CRON_TOKEN=your_secret_token_here
